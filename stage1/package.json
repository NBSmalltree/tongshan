{
  "name": "tongshan-culture-platform",
  "version": "1.0.0",
  "description": "奉化-在地文化数字共创平台（一阶段离线大屏展示系统）",
  "main": "./out/main/index.js",
  "author": "奉化",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "simple-keyboard": "^3.8.0",
    "pinyin-pro": "^3.26.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^25.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
